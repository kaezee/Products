# Copy to .env.local and fill in. The publishable (anon) key is safe for the
# browser — Row-Level Security is what actually protects data, not key secrecy.
VITE_SUPABASE_URL=https://lluszbukkqlohzvjdajb.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Product analytics (Foundations §4) — OPTIONAL and OFF unless BOTH are set.
# Counts and event names only, never content. Point at a self-hosted
# Plausible/Umami ingest to switch it on; leave unset to keep it dormant.
# VITE_ANALYTICS_DOMAIN=kronicler.app
# VITE_ANALYTICS_URL=https://plausible.example.com/api/event
